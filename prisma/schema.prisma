// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  CREATOR
  ADMIN
}

enum VideoStatus {
  PROCESSING
  PUBLISHED
  PRIVATE
  BANNED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String

  hashedRefreshToken String?

  role      UserRole @default(USER)

  videos    Video[]
  comments  Comment[]
  likes     VideoLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Video {
  id           String   @id @default(uuid())

  title        String
  slug         String   @unique
  originalTitle String?
  director     String   @default("Unknown Director")
  studio       String   @default("Independent")
  year         String   @default("2024")
  duration     String   @default("00:00")
  aspectRatio  String   @default("16:9")
  audioFormat  String   @default("Stereo")
  colorGrade   String   @default("Standard Rec.709")
  colorPalette String[] @default([])
  curatorQuote String?
  awards       String[] @default([])
  mood         String   @default("all")
  moodLabel    String   @default("Koleksi Umum")
  backdrop     String   @default("")
  poster       String?
  isFeatured   Boolean  @default(false)
  chapters     Json?    @default("[]")

  description  String?

  videoUrl     String
  thumbnailUrl String?

  tags         String[]

  views        Int @default(0)

  status       VideoStatus @default(PROCESSING)

  userId       String
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  comments     Comment[]
  likes        VideoLike[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Comment {
  id        String   @id @default(uuid())

  content   String

  userId    String
  videoId   String

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VideoLike {
  id        String   @id @default(uuid())

  userId    String
  videoId   String

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, videoId])
}